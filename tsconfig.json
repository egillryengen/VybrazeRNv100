// prettier-ignore
{
  "extends": "@tsconfig/react-native/tsconfig.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "moduleResolution": "node",
    "skipLibCheck": true,
    "baseUrl": "./",
    "paths": {
      "*": ["src/*"]
    },
    "types": ["node", "jest"],
    "lib": ["es2019", "dom"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
